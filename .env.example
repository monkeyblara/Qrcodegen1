# Application Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=3000
NODE_ENV=production
ELECTRON_DEV=false

# Database Configuration
# Local: mongodb://localhost:27017/qr-paint-system
# Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/qr-paint-system?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/qr-paint-system

# Optional: If using a separate API domain for the client
# REACT_APP_API_URL=https://your-api-domain.com

# Security (Optional)
JWT_SECRET=your-secret-key-here
# API_KEY=your-api-key-here

# Do not commit actual secret values into source control.

